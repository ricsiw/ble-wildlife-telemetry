---
// No images — text only with a subtle CTA treatment
---

<section class="custom-section" id="custom-transmitters">
  <div class="page-container">
    <div class="custom-inner reveal">

      <div class="custom-text">
        <span class="section-label">Bespoke</span>
        <h3 class="subsection-title">Custom Transmitters</h3>
        <p class="body-text">
          Every research project has its own unique challenges. Because of this, we build custom
          transmitters tailored to your specific requirements. We can add various types of sensors
          or change the shape and size of the housing to match your needs.
        </p>
      </div>

      <div class="cta-box glass-card">
        <p class="cta-label">Get In Touch</p>
        <p class="cta-body">
          If you are interested in a custom transmitter solution, please reach out to us and we
          will discuss your requirements.
        </p>
        <a href="mailto:info@example.com" class="cta-btn" id="contact-link">
          Contact Us
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
.custom-section {
  padding-block: 4rem;
}

.custom-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

/* ── CTA box ─────────────────────────────────────────────────── */
.cta-box {
  padding: 2rem;
  border-color: rgba(78, 204, 163, 0.25);
}

.cta-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--c-teal);
  margin-bottom: 0.75rem;
}

.cta-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--c-text-dim);
  margin-bottom: 1.5rem;
}

.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--c-surface);
  background: var(--c-teal);
  padding: 0.65rem 1.4rem;
  border-radius: 0.5rem;
  text-decoration: none;
  transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
  box-shadow: 0 0 0 0 rgba(78, 204, 163, 0.4);
}

.cta-btn:hover {
  background: #66ddb5;
  transform: translateY(-1px);
  box-shadow: 0 0 20px rgba(78, 204, 163, 0.35);
}

@media (max-width: 900px) {
  .custom-inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
</style>
