---
// No images — text only with a subtle CTA treatment
---

<section class="custom-section" id="custom-transmitters">
  <div class="page-container">
    <div class="custom-inner reveal">

      <div class="custom-text">
        <h3 class="subsection-title">Custom Transmitters</h3>
        <p class="body-text">
          Every research project has its own unique challenges. Because of this, we build custom
          transmitters tailored to your specific requirements. We can add various types of sensors
          or change the shape and size of the housing to match your needs.
        </p>
      </div>

      <div class="cta-box glass-card">
        <p class="cta-label">Get In Touch</p>
        <p class="cta-body">
          If you are interested in a custom transmitter solution, please reach out to us and we
          will discuss your requirements.
        </p>
        <p class="cta-email">Email: <a href="mailto:wohlfart@telemetry.hu" id="contact-link">wohlfart@telemetry.hu</a></p>
        <p class="cta-site">Website: <a href="https://www.telemetry.hu" target="_blank" rel="noopener noreferrer">www.telemetry.hu</a></p>
      </div>

    </div>
  </div>
</section>

<style>
.custom-section {
  padding-block: 4rem;
}

.custom-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

/* ── CTA box ─────────────────────────────────────────────────── */
.cta-box {
  padding: 2rem;
  border-color: rgba(78, 204, 163, 0.25);
}

.cta-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--c-teal);
  margin-bottom: 0.75rem;
}

.cta-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--c-text-dim);
  margin-bottom: 0.8rem;
}

.cta-email {
  margin: 0 0 1.3rem;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.82rem;
  color: var(--c-text);
}

.cta-email a {
  color: var(--c-teal);
  text-decoration: none;
  border-bottom: 1px solid rgba(78, 204, 163, 0.35);
}

.cta-email a:hover {
  color: #66ddb5;
  border-bottom-color: rgba(102, 221, 181, 0.75);
}
.cta-site {
  margin: 0;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  color: var(--c-text-dim);
}

.cta-site a {
  color: var(--c-teal);
  text-decoration: none;
  border-bottom: 1px solid rgba(78, 204, 163, 0.35);
}

.cta-site a:hover {
  color: #66ddb5;
  border-bottom-color: rgba(102, 221, 181, 0.75);
}

@media (max-width: 900px) {
  .custom-inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
</style>
