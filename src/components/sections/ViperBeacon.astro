---
import Gallery from '../Gallery.astro';
import imgSchematic  from '../../assets/Beacons/beacon-schematic.jpg';
import imgPackaging  from '../../assets/Beacons/Beacons-In-Packaging.jpg';
import imgBeacon     from '../../assets/Beacons/BLE Beacon.jpg';

const specs = [
  ['Max Width',                        '11.5 mm'],
  ['Min Width',                        '7.5 mm'],
  ['Length',                           '24 mm'],
  ['Height',                           '5.2 mm'],
  ['Weight',                           '1.8 g'],
  ['Typ. Temperature Sensor Accuracy', '±0.1 °C *'],
  ['Temperature Sampling Frequency',   '1 per 20 seconds'],
  ['Total Operating Time',             '~2 years'],
  ['Total Standby Time',               '6–8 years'],
];
---

<section class="viper-section" id="viper-beacon">
  <div class="page-container">

    <div class="reveal">
      <h3 class="subsection-title">Implantable Viper Temperature Monitoring Beacon</h3>
      <p class="body-text">
        Our viper transmitters are built for long-term monitoring and real-time data transfer.
        They feature a tissue-friendly epoxy coating and have no external antenna. The beacons
        include a built-in TMR magnetic switch, which lets you put the transmitter into sleep mode
        during storage to save battery. Transmission intervals are configurable based on your
        project requirements, directly affecting overall battery life.
      </p>
    </div>

    <div class="viper-grid">

      <!-- Spec table -->
      <div class="reveal viper-table-wrap">
        <div class="glass-card spec-card">
          <table class="spec-table">
            <thead>
              <tr>
                <th>Beacon Property</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              {specs.map(([prop, val]) => (
                <tr>
                  <td class="prop-cell">{prop}</td>
                  <td class="val-cell">{val}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="spec-footnote">
            * For accuracy distribution details, see Sensirion STS40 documentation.
          </p>
        </div>
      </div>

      <!-- Spec image sliding gallery -->
      <div class="viper-gallery-wrap reveal reveal-delay-1">
        <Gallery
          containerId="beacon-gallery"
          images={[
            { src: imgSchematic, alt: "Viper beacon dimensions", caption: "Viper Beacon Dimensions" },
            { src: imgPackaging, alt: "Magnetic beacon hibernation packaging", caption: "Magnetic Beacon Hibernation Packaging" },
            { src: imgBeacon, alt: "BLE viper beacon", caption: "BLE Viper Beacon" },
          ]}
          autoSlideInterval={5000}
        />
      </div>

    </div>
  </div>
</section>

<style>
.viper-section {
  padding-block: 4rem 3rem;
}

.viper-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 2rem;
  margin-top: 2rem;
  align-items: start;
}

/* ── Spec Table ─────────────────────────────────────────────── */
.spec-card {
  overflow: hidden;
  padding-bottom: 0.75rem;
}

.spec-table {
  width: 100%;
  border-collapse: collapse;
}

.spec-table thead tr {
  background: rgba(78, 204, 163, 0.14);
  border-bottom: 1px solid rgba(78, 204, 163, 0.2);
}

.spec-table th {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--c-teal);
  padding: 0.8rem 1.1rem;
  text-align: left;
  font-weight: 700;
}

.spec-table td {
  padding: 0.7rem 1.1rem;
  font-size: 0.88rem;
  border-bottom: 1px solid rgba(78, 204, 163, 0.07);
  vertical-align: middle;
  color: var(--c-text-dim);
}

.spec-table tr:nth-child(even) td {
  background: rgba(22, 40, 36, 0.3);
}

.prop-cell {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  color: var(--c-text);
}

.val-cell {
  text-align: right;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  font-size: 0.88rem;
  color: var(--c-teal);
  white-space: nowrap;
}

.spec-footnote {
  font-size: 0.72rem;
  color: var(--c-text-muted);
  padding: 0.6rem 1.1rem 0;
  line-height: 1.5;
}

/* ── Gallery styling ───────────────────────────────────────── */
.viper-gallery-wrap {
  width: 100%;
}

@media (max-width: 1023px) {
  .viper-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 767px) {
  .viper-section {
    padding-block: 3rem 2rem;
  }
  
  .viper-grid {
    gap: 1.5rem;
  }
}
</style>

