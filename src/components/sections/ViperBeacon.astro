---
import { Image } from 'astro:assets';
import imgSchematic  from '../../assets/Beacons/beacon-schematic.jpg';
import imgPackaging  from '../../assets/Beacons/Beacons-In-Packaging.jpg';
import imgBeacon     from '../../assets/Beacons/BLE Beacon.jpg';

const specs = [
  ['Max Width',                        '11.5 mm'],
  ['Min Width',                        '7.5 mm'],
  ['Length',                           '24 mm'],
  ['Height',                           '5.2 mm'],
  ['Weight',                           '1.8 g'],
  ['Typ. Temperature Sensor Accuracy', '±0.1 °C *'],
  ['Temperature Sampling Frequency',   '1 per 20 seconds'],
  ['Total Operating Time',             '~2 years'],
  ['Total Standby Time',               '6–8 years'],
];
---

<section class="viper-section" id="viper-beacon">
  <div class="page-container">

    <div class="reveal">
      <span class="section-label">Implantable</span>
      <h3 class="subsection-title">Viper Temperature Monitoring Beacon</h3>
      <p class="body-text">
        Our viper transmitters are built for long-term monitoring and real-time data transfer.
        They feature a tissue-friendly epoxy coating and have no external antenna. The beacons
        include a built-in TMR magnetic switch, which lets you put the transmitter into sleep mode
        during storage to save battery. Transmission intervals are configurable based on your
        project requirements, directly affecting overall battery life.
      </p>
    </div>

    <div class="viper-grid">

      <!-- Spec table -->
      <div class="reveal viper-table-wrap">
        <div class="glass-card spec-card">
          <table class="spec-table">
            <thead>
              <tr>
                <th>Beacon Property</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              {specs.map(([prop, val]) => (
                <tr>
                  <td class="prop-cell">{prop}</td>
                  <td class="val-cell">{val}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="spec-footnote">
            * For accuracy distribution details, see Sensirion STS40 documentation.
          </p>
        </div>
      </div>

      <!-- 3-image gallery -->
      <div class="viper-images reveal reveal-delay-1">
        <!-- Schematic (841×581) -->
        <div class="beacon-img-card glass-card beacon-schematic">
          <Image src={imgSchematic} alt="Viper beacon schematic drawing" class="beacon-img" />
        </div>
        <!-- Packaging (1500×1331, ~square) -->
        <div class="beacon-img-card glass-card beacon-packaging">
          <Image src={imgPackaging} alt="Viper beacons in packaging" class="beacon-img" />
        </div>
        <!-- Beacon photo (1635×1200, landscape) -->
        <div class="beacon-img-card glass-card beacon-photo">
          <Image src={imgBeacon} alt="BLE beacon close-up" class="beacon-img" />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.viper-section {
  padding-block: 4rem 3rem;
}

.viper-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 2rem;
  margin-top: 2rem;
  align-items: start;
}

/* ── Spec Table ─────────────────────────────────────────────── */
.spec-card {
  overflow: hidden;
  padding-bottom: 0.75rem;
}

.spec-table {
  width: 100%;
  border-collapse: collapse;
}

.spec-table thead tr {
  background: rgba(78, 204, 163, 0.14);
  border-bottom: 1px solid rgba(78, 204, 163, 0.2);
}

.spec-table th {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--c-teal);
  padding: 0.8rem 1.1rem;
  text-align: left;
  font-weight: 700;
}

.spec-table td {
  padding: 0.7rem 1.1rem;
  font-size: 0.88rem;
  border-bottom: 1px solid rgba(78, 204, 163, 0.07);
  vertical-align: middle;
  color: var(--c-text-dim);
}

.spec-table tr:nth-child(even) td {
  background: rgba(22, 40, 36, 0.3);
}

.prop-cell {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  color: var(--c-text);
}

.val-cell {
  text-align: right;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  font-size: 0.88rem;
  color: var(--c-teal);
  white-space: nowrap;
}

.spec-footnote {
  font-size: 0.72rem;
  color: var(--c-text-muted);
  padding: 0.6rem 1.1rem 0;
  line-height: 1.5;
}

/* ── Image gallery ──────────────────────────────────────────── */
.viper-images {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 0.6rem;
}

.beacon-img-card {
  overflow: hidden;
}

.beacon-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}
.beacon-img-card:hover .beacon-img {
  transform: scale(1.04);
}

/* Schematic spans both columns, shorter height */
.beacon-schematic {
  grid-column: 1 / 3;
  grid-row: 1;
}
.beacon-schematic .beacon-img {
  aspect-ratio: 841 / 581;
  height: auto;
}

/* Packaging — square-ish */
.beacon-packaging {
  grid-column: 1;
  grid-row: 2;
}
.beacon-packaging .beacon-img {
  aspect-ratio: 1 / 1;
}

/* Photo — landscape */
.beacon-photo {
  grid-column: 2;
  grid-row: 2;
}
.beacon-photo .beacon-img {
  aspect-ratio: 1635 / 1200;
}

@media (max-width: 900px) {
  .viper-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
</style>
