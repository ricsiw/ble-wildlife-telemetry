---
import Gallery from '../Gallery.astro';
import imgActivity    from '../../assets/Software/software-activity.png';
import imgTemperature from '../../assets/Software/software-temperature.png';
---

<section class="datalogger-section" id="data-logger">
  <div class="page-container">

    <div class="reveal">
      <h3 class="subsection-title">Data Logger Software</h3>
    </div>

    <div class="datalogger-inner">

      <!-- Text -->
      <div class="logger-text reveal">
        <p class="body-text">
          The data logger software collects, processes, and displays the data. It can run on any
          Linux or Windows machine, including single board computers like the Raspberry Pi. The user
          interface is a webpage hosted directly by the software — accessible via any browser on
          your local network, or anywhere in the world over the internet.
        </p>
        <p class="body-text" style="margin-top:1rem;">
          The data updates live, so you can see current readings and sensor measurements as they
          happen. The software features status widgets and charts that can smoothly display more
          than 1 million past data points.
        </p>
      </div>

      <!-- Gallery -->
      <div class="gallery-outer reveal reveal-delay-1">
        <Gallery
          containerId="software-gallery"
          images={[
            { src: imgActivity, alt: "Data logger — activity view" },
            { src: imgTemperature, alt: "Data logger — temperature chart" },
          ]}
          autoSlideInterval={4500}
        />
      </div>

    </div>
  </div>
</section>

<style>
.datalogger-section {
  padding-block: 3.5rem;
}

.datalogger-inner {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  align-items: flex-start;
  margin-top: 2rem;
}

.logger-text {
  width: 100%;
}

.gallery-outer {
  width: 100%;
}
</style>
