---
import { Image } from 'astro:assets';
import desktopBg      from '../../assets/Banner Desktop/Banner Layer 1.jpg';
import desktopDevices from '../../assets/Banner Desktop/Banner Layer 3 Devices.png';
import desktopTitle   from '../../assets/Banner Desktop/Banner Layer 4 Title Text.png';
import mobileBg       from '../../assets/Banner Mobile/Banner Layer 1.jpg';
import mobileDevices  from '../../assets/Banner Mobile/Banner Layer 3 Devices.png';
import mobileTitle    from '../../assets/Banner Mobile/Banner Layer 4 Title Text.png';
---

<section class="banner" aria-label="Product hero">

  <!-- ── Desktop Banner (≥768px) ────────────────────────────── -->
  <div class="banner-wrap desktop-wrap">
    <!-- L1: Background -->
    <Image src={desktopBg} alt="" class="layer" loading="eager" fetchpriority="high" />

    <!-- L2: Animated circles @ 30% soft-light -->
    <div class="layer circles-wrap blend-soft op30" aria-hidden="true">
      <div class="circle c1"></div>
      <div class="circle c2"></div>
      <div class="circle c3"></div>
      <div class="circle c4"></div>
      <div class="circle c5"></div>
      <div class="circle c6"></div>
    </div>

    <!-- L3: Devices – float in on load -->
    <Image src={desktopDevices} alt="BLE telemetry hardware" class="layer devices-layer" loading="eager" />

    <!-- L4: Pre-rendered title text -->
    <Image src={desktopTitle} alt="Bluetooth Radio Telemetry — Integrated Temperature Monitoring" class="layer" loading="eager" />

    <!-- L5: Subtle circles @ 8% -->
    <div class="layer circles-wrap blend-soft op8" aria-hidden="true">
      <div class="circle c1"></div>
      <div class="circle c3"></div>
      <div class="circle c5"></div>
      <div class="circle c6"></div>
      <div class="circle c2 shifted"></div>
      <div class="circle c4 shifted"></div>
    </div>
  </div>

  <!-- ── Mobile Banner (<768px) ─────────────────────────────── -->
  <div class="banner-wrap mobile-wrap">
    <Image src={mobileBg} alt="" class="layer" loading="eager" fetchpriority="high" />

    <div class="layer circles-wrap blend-soft op30" aria-hidden="true">
      <div class="circle mc1"></div>
      <div class="circle mc2"></div>
      <div class="circle mc3"></div>
      <div class="circle mc4"></div>
      <div class="circle mc5"></div>
      <div class="circle mc6"></div>
    </div>

    <Image src={mobileDevices} alt="BLE telemetry hardware" class="layer devices-layer" loading="eager" />
    <Image src={mobileTitle} alt="Bluetooth Radio Telemetry — Integrated Temperature Monitoring" class="layer" loading="eager" />

    <div class="layer circles-wrap blend-soft op8" aria-hidden="true">
      <div class="circle mc1"></div>
      <div class="circle mc3"></div>
      <div class="circle mc5"></div>
    </div>
  </div>

</section>

<style>
/* ── Banner container ─────────────────────────────────────── */
.banner { width: 100%; overflow: hidden; }

.banner-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.desktop-wrap {
  display: none;
  aspect-ratio: 3840 / 1728;
}
.mobile-wrap {
  display: block;
  aspect-ratio: 1920 / 2558;
}

@media (min-width: 768px) {
  .desktop-wrap { display: block; }
  .mobile-wrap  { display: none; }
}

/* ── Layers ─────────────────────────────────────────────────── */
.layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── Circle layer container ─────────────────────────────────── */
.circles-wrap {
  pointer-events: none;
}
.blend-soft { mix-blend-mode: screen; }
.op30 { opacity: 0.3; }
.op8  { opacity: 0.08; }

/* ── Individual circles ─────────────────────────────────────── */
.circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%,
    rgba(220, 255, 240, 0.95),
    rgba(78, 204, 163, 0.6) 50%,
    transparent 80%
  );
}

/* Desktop: circles on left/bottom portion */
.c1 { width: 26%; aspect-ratio: 1; left: 2%;  bottom: 8%;  animation: f1 9s  ease-in-out infinite; }
.c2 { width: 17%; aspect-ratio: 1; left: 14%; top: 18%;    animation: f2 11s ease-in-out infinite 1.2s; }
.c3 { width: 21%; aspect-ratio: 1; left: 20%; bottom: 22%; animation: f3 8.5s ease-in-out infinite 2.4s; }
.c4 { width: 11%; aspect-ratio: 1; left: 1%;  top: 42%;    animation: f1 7s  ease-in-out infinite 0.6s; }
.c5 { width: 15%; aspect-ratio: 1; left: 30%; bottom: 4%;  animation: f2 12s ease-in-out infinite 3.1s; }
.c6 { width: 19%; aspect-ratio: 1; left: 7%;  top: 58%;    animation: f3 9s  ease-in-out infinite 1.8s; }
.shifted { transform: translate(8%, -12%); }

/* Mobile: circles in lower portion */
.mc1 { width: 55%; aspect-ratio: 1; left: -10%; bottom: 15%; animation: f1 9s  ease-in-out infinite; }
.mc2 { width: 35%; aspect-ratio: 1; left: 40%;  bottom: 30%; animation: f2 11s ease-in-out infinite 1s; }
.mc3 { width: 42%; aspect-ratio: 1; left: 15%;  bottom: 5%;  animation: f3 10s ease-in-out infinite 2s; }
.mc4 { width: 25%; aspect-ratio: 1; left: 60%;  bottom: 12%; animation: f1 8s  ease-in-out infinite 0.5s; }
.mc5 { width: 30%; aspect-ratio: 1; left: 5%;   bottom: 40%; animation: f2 13s ease-in-out infinite 3s; }
.mc6 { width: 20%; aspect-ratio: 1; left: 70%;  bottom: 25%; animation: f3 7.5s ease-in-out infinite 1.5s; }

/* ── Float keyframes ────────────────────────────────────────── */
@keyframes f1 {
  0%, 100% { transform: translateY(0)   translateX(0); }
  50%       { transform: translateY(-14px) translateX(10px); }
}
@keyframes f2 {
  0%, 100% { transform: translateY(0)    translateX(0); }
  35%       { transform: translateY(12px) translateX(-9px); }
  75%       { transform: translateY(-8px) translateX(7px); }
}
@keyframes f3 {
  0%, 100% { transform: translateY(0)    translateX(0); }
  30%       { transform: translateY(-18px) translateX(5px); }
  70%       { transform: translateY(7px)  translateX(-11px); }
}

/* ── Device layer entrance ──────────────────────────────────── */
.devices-layer {
  animation: deviceEnter 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.25s;
  opacity: 0;
}
@keyframes deviceEnter {
  from { opacity: 0; transform: translateY(-3%); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>
