---
import { Image } from 'astro:assets';
import desktopBg      from '../../assets/Banner Desktop/Banner Layer 1.jpg';
import desktopDevices from '../../assets/Banner Desktop/Banner Layer 3 Devices.png';
import desktopTitle   from '../../assets/Banner Desktop/Banner Layer 4 Title Text.png';
import mobileBg       from '../../assets/Banner Mobile/Banner Layer 1.jpg';
import mobileDevices  from '../../assets/Banner Mobile/Banner Layer 3 Devices.png';
import mobileTitle    from '../../assets/Banner Mobile/Banner Layer 4 Title Text.png';
---

<section class="banner" aria-label="Product hero">

  <!-- ── Desktop Banner (≥768px) ────────────────────────────── -->
  <div class="banner-wrap desktop-wrap">
    <!-- L1: Background -->
    <Image src={desktopBg} alt="" class="layer z-bg" loading="eager" fetchpriority="high" />

    <!-- L2: Animated circles @ 35% opacity (behind devices) -->
    <div class="layer circles-wrap blend-soft z-back-circles" aria-hidden="true">
      <div class="circle c1"></div>
      <div class="circle c3"></div>
      <div class="circle c5"></div>
    </div>

    <!-- L3: Devices – float in on load -->
    <Image src={desktopDevices} alt="BLE telemetry hardware" class="layer devices-layer z-devices" loading="eager" />

    <!-- L4: Animated circles @ 28% opacity (in front of devices) -->
    <div class="layer circles-wrap blend-soft z-front-circles" aria-hidden="true">
      <div class="circle c2"></div>
      <div class="circle c4"></div>
      <div class="circle c6"></div>
    </div>

    <!-- L5: Pre-rendered title text -->
    <Image src={desktopTitle} alt="Bluetooth Radio Telemetry — Integrated Temperature Monitoring" class="layer z-title" loading="eager" />
  </div>

  <!-- ── Mobile Banner (<768px) ─────────────────────────────── -->
  <div class="banner-wrap mobile-wrap">
    <!-- L1: Background -->
    <Image src={mobileBg} alt="" class="layer z-bg" loading="eager" fetchpriority="high" />

    <!-- L2: Animated circles @ 35% opacity (behind devices) -->
    <div class="layer circles-wrap blend-soft z-back-circles" aria-hidden="true">
      <div class="circle mc1"></div>
      <div class="circle mc3"></div>
      <div class="circle mc5"></div>
    </div>

    <!-- L3: Devices -->
    <Image src={mobileDevices} alt="BLE telemetry hardware" class="layer devices-layer z-devices" loading="eager" />

    <!-- L4: Animated circles @ 28% opacity (in front of devices) -->
    <div class="layer circles-wrap blend-soft z-front-circles" aria-hidden="true">
      <div class="circle mc2"></div>
      <div class="circle mc4"></div>
      <div class="circle mc6"></div>
    </div>

    <!-- L5: Title Text -->
    <Image src={mobileTitle} alt="Bluetooth Radio Telemetry — Integrated Temperature Monitoring" class="layer z-title" loading="eager" />
  </div>

</section>

<style>
/* ── Banner container ─────────────────────────────────────── */
.banner { width: 100%; overflow: hidden; }

.banner-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.desktop-wrap {
  display: none;
  aspect-ratio: 3840 / 1728;
}
.mobile-wrap {
  display: block;
  aspect-ratio: 1920 / 2558;
}

@media (min-width: 768px) {
  .desktop-wrap { display: block; }
  .mobile-wrap  { display: none; }
}

/* ── Layers ─────────────────────────────────────────────────── */
.layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* explicit z-index layers */
.z-bg { z-index: 1; }
.z-back-circles { z-index: 2; opacity: 0.35; }
.z-devices { z-index: 3; }
.z-front-circles { z-index: 4; opacity: 0.18; }
.z-title { z-index: 5; }

/* ── Circle layer container ─────────────────────────────────── */
.circles-wrap {
  pointer-events: none;
}
.blend-soft { mix-blend-mode: screen; }

/* ── Individual circles ─────────────────────────────────────── */
.circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%,
    rgba(220, 255, 240, 0.95),
    rgba(78, 204, 163, 0.6) 50%,
    transparent 80%
  );
}

/* Desktop: more even vertical distribution, 20% smaller average size, 0.25x animation speed */
.c1 { width: 27%; aspect-ratio: 1; right: 6%;  top: 14%; animation: f1 38s ease-in-out infinite; }
.c2 { width: 10%; aspect-ratio: 1; right: 24%; top: 32%; animation: f2 46s ease-in-out infinite 1.2s; }
.c3 { width: 22%; aspect-ratio: 1; right: 12%; top: 56%; animation: f3 36s ease-in-out infinite 2.4s; }
.c4 { width: 6%;  aspect-ratio: 1; right: 34%; top: 18%; animation: f1 30s ease-in-out infinite 0.6s; }
.c5 { width: 14%; aspect-ratio: 1; right: 30%; top: 62%; animation: f2 52s ease-in-out infinite 3.1s; }
.c6 { width: 18%; aspect-ratio: 1; right: 4%;  top: 40%; animation: f3 34s ease-in-out infinite 1.8s; }

/* Mobile: shifted right and more even spread, 20% smaller average size, 0.25x animation speed */
.mc1 { width: 50%; aspect-ratio: 1; right: -6%; top: 26%; animation: f1 38s ease-in-out infinite; }
.mc2 { width: 22%; aspect-ratio: 1; right: 18%; top: 10%; animation: f2 46s ease-in-out infinite 1s; }
.mc3 { width: 38%; aspect-ratio: 1; right: 4%;  top: 58%; animation: f3 42s ease-in-out infinite 2s; }
.mc4 { width: 13%; aspect-ratio: 1; right: 36%; top: 38%; animation: f1 34s ease-in-out infinite 0.5s; }
.mc5 { width: 30%; aspect-ratio: 1; right: 0%;  top: 74%; animation: f2 54s ease-in-out infinite 3s; }
.mc6 { width: 18%; aspect-ratio: 1; right: 28%; top: 66%; animation: f3 32s ease-in-out infinite 1.5s; }

/* ── Float keyframes ────────────────────────────────────────── */
@keyframes f1 {
  0%, 100% { transform: translateY(0) translateX(0) scale(1); }
  20%      { transform: translateY(-12px) translateX(8px) scale(1.03); }
  50%      { transform: translateY(-26px) translateX(18px) scale(1.06); }
  80%      { transform: translateY(-10px) translateX(6px) scale(1.02); }
}
@keyframes f2 {
  0%, 100% { transform: translateY(0) translateX(0) scale(1); }
  25%      { transform: translateY(18px) translateX(-16px) scale(0.96); }
  45%      { transform: translateY(7px) translateX(-6px) scale(0.98); }
  75%      { transform: translateY(-16px) translateX(14px) scale(1.04); }
}
@keyframes f3 {
  0%, 100% { transform: translateY(0) translateX(0) scale(1); }
  22%      { transform: translateY(-30px) translateX(8px) scale(1.05); }
  55%      { transform: translateY(12px) translateX(-18px) scale(0.95); }
  78%      { transform: translateY(-8px) translateX(-6px) scale(1.01); }
}

/* ── Device layer entrance ──────────────────────────────────── */
.devices-layer {
  animation: deviceEnter 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: 0.05s;
  opacity: 0;
}
@keyframes deviceEnter {
  from { opacity: 0; transform: translateY(-3%); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>
